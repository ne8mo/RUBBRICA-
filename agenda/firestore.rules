rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un solo accesso per tutti e tre. Se il nome utente non è "agenda",
    // cambia la parola prima di @agenda-a-tre.app (in minuscolo).
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email == 'agenda@agenda-a-tre.app';
    }

    // Tutti i dati dell'agenda: profili, appuntamenti, rubrica.
    match /agenda/principale/{col}/{id} {
      allow read, write: if autorizzato()
        && col in ['profiles', 'appts', 'contacts'];
    }
    // Tutto il resto è chiuso.
  }
}
