rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni agenda vive sotto /agende/<codice>. Il codice è lungo e casuale:
    // solo chi ha il link può leggere e scrivere. Non è consentito elencare le agende.
    match /agende/{code}/{col}/{id} {
      allow read, write: if code.size() >= 12
        && col in ['profiles', 'appts', 'contacts']
        && (request.resource == null || request.resource.size() < 64);
    }
  }
}
