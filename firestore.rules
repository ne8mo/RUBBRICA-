rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo gli account del negozio elencati qui possono leggere e scrivere.
    // Per aggiungere una persona: aggiungi la sua email tra le parentesi quadre, separata da una virgola.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['santagian97@gmail.com'];
    }
  }
}
