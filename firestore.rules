rules_version = '2';

// Regole di sicurezza del progetto Firebase "Rubbrica future's sun".
// Il progetto è usato da DUE app: "Schede colore" e "Rubrica Salone".
// Quando modifichi queste regole, lascia sempre le parti di entrambe le app.
//
// Schede colore: un solo accesso per tutto il salone, nickname "futuresun"
// (per Firebase è l'email interna futuresun@staff.schede-colore.app, non un indirizzo vero).
// Rubrica Salone: entra con santagian97@gmail.com oppure con l'accesso "futuresun".
// Qualsiasi altro account, o chi non ha fatto l'accesso, non può leggere né scrivere nulla.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Schede colore ----------
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email == 'futuresun@staff.schede-colore.app';
    }
    function testo(campo, max) {
      return !(campo in request.resource.data)
        || request.resource.data[campo] == null
        || (request.resource.data[campo] is string && request.resource.data[campo].size() <= max);
    }

    // Data dell'ultimo backup scaricato (per il promemoria).
    match /config/backup {
      allow read: if autorizzato();
      allow write: if autorizzato() && request.resource.data.keys().hasOnly(['ultimo', 'da']);
    }

    match /parrucchiere/{id} {
      allow read, delete: if autorizzato();
      allow create, update: if autorizzato()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 60;
    }

    match /clienti/{clienteId} {
      allow read, delete: if autorizzato();
      allow create, update: if autorizzato()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && testo('nome', 80) && testo('cognome', 80) && testo('telefono', 30)
        && testo('note', 3000) && testo('parrucchiera', 60);

      // foto delle schede cartacee, già compresse dall'app (un documento Firestore pesa al massimo 1 MB)
      match /foto/{fotoId} {
        allow read, delete: if autorizzato();
        allow create, update: if autorizzato()
          && request.resource.data.immagine is string
          && request.resource.data.immagine.size() <= 1000000
          && testo('nota', 500) && testo('dataScheda', 10);
      }

      match /schede/{schedaId} {
        allow read, delete: if autorizzato();
        allow create, update: if autorizzato()
          && request.resource.data.data is string
          && testo('servizio', 80) && testo('formula', 5000) && testo('ossigeno', 60)
          && testo('posa', 30) && testo('note', 5000) && testo('parrucchiera', 60);
      }
    }

    // ---------- Rubrica Salone ----------
    function rubrica() {
      return request.auth != null
        && request.auth.token.email in ['santagian97@gmail.com', 'futuresun@staff.schede-colore.app'];
    }

    match /contacts/{id} {
      allow read, write: if rubrica();
    }

    match /sections/{id} {
      allow read, write: if rubrica();
    }

    // Tutto il resto è chiuso.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
