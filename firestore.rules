rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo chi entra con un account del negozio può leggere e scrivere.
    // IMPORTANTE: in Authentication → Impostazioni → Azioni utente la registrazione
    // deve essere disattivata, così gli account li crea solo la titolare.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
